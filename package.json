{
  "name": "tk-seed",
  "version": "0.1.0",
  "description": "Seed a Turnkey organization with sub-orgs, users, wallets, policies, and private keys.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tk-seed": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@turnkey/crypto": "^2.4.0",
    "@turnkey/sdk-server": "^4.10.1",
    "@types/cli-progress": "^3.11.6",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
